server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${VMS_STAFF_HOST} ${VMS_VISITOR_HOST};
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    server_name ${VMS_STAFF_HOST};
    ssl_certificate /etc/nginx/tls/staff.crt;
    ssl_certificate_key /etc/nginx/tls/staff.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(self), microphone=()" always;
    add_header Referrer-Policy "no-referrer" always;
    client_max_body_size 64k;
    root /usr/share/nginx/html;

    location = /api/csrf { include /etc/nginx/vms-proxy.conf; }
    location ^~ /api/staff/ { include /etc/nginx/vms-proxy.conf; }
    location ^~ /api/ { return 404; }
    location ^~ /visitor { return 404; }
    location ^~ /assets/ { try_files $uri =404; }
    location / { try_files $uri /index.html; }
}

server {
    listen 443 ssl;
    server_name ${VMS_VISITOR_HOST};
    ssl_certificate /etc/nginx/tls/visitor.crt;
    ssl_certificate_key /etc/nginx/tls/visitor.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Permissions-Policy "camera=(), microphone=()" always;
    add_header Referrer-Policy "no-referrer" always;
    client_max_body_size 64k;
    root /usr/share/nginx/html;

    location = / { return 302 /visitor; }
    location = /api/csrf { include /etc/nginx/vms-proxy.conf; }
    location ^~ /api/visitor/ { include /etc/nginx/vms-proxy.conf; }
    location ^~ /api/ { return 404; }
    location = /visitor { try_files $uri /index.html; }
    location ^~ /assets/ { try_files $uri =404; }
    location = /index.html { internal; }
    location / { return 404; }
}
